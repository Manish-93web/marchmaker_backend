# ---- Core ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Data stores ---------------------------------------------------------
# Replica set is required for transactions (docker compose provides rs0).
MONGODB_URI=mongodb://127.0.0.1:27017/marchmaker?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth / cookies ------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-012345678
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ---- URLs / CORS ---------------------------------------------------------
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Field encryption (AES-256-GCM) -------------------------------------
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: load from KMS / secret manager, never commit.
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktZmllbGQtZW5jcnlwdGlvbi1rZXktMzI=

# ---- Object storage (R2 / S3 / MinIO) -- used from Phase 4 -----------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_PHOTOS=marchmaker-photos
S3_BUCKET_IDENTITY=marchmaker-identity
S3_BUCKET_DOCUMENTS=marchmaker-documents
# Identity bucket must use separate credentials in production:
S3_IDENTITY_ACCESS_KEY_ID=minioadmin
S3_IDENTITY_SECRET_ACCESS_KEY=minioadmin

# ---- Notifications -- Phase 11 -------------------------------------------
WHATSAPP_PROVIDER=mock      # none | mock | meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
PUSH_PROVIDER=mock          # none | mock | webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@marchmaker.local
ONCALL_EMAIL=

# ---- Optional features -- Phase 15 (switch on in the console) -------------
CALLS_PROVIDER=mock         # none | mock | exotel
CALLS_WEBHOOK_SECRET=dev-only-calls-webhook-secret
CALLS_CALLER_ID=
EXOTEL_SID=
EXOTEL_KEY=
EXOTEL_TOKEN=
ASTROLOGY_PROVIDER=mock     # none | mock | rest
ASTROLOGY_BASE_URL=
ASTROLOGY_API_KEY=

# ---- Payments (Razorpay) -- Phase 10 --------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev-only-razorpay-webhook-secret   # must be non-empty; use the dashboard's secret in production
PAYMENTS_PROVIDER=mock   # mock | razorpay

# ---- Email (Resend) -- Phase 2/11 ----------------------------------------
EMAIL_PROVIDER=mailpit   # mailpit | resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Marchmaker <hello@example.com>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# ---- WhatsApp Cloud API -- Phase 11 ---------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- SMS / OTP -- Phase 2 -------------------------------------------------
SMS_PROVIDER=mock        # mock | msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- KYC / liveness -- Phase 6 --------------------------------------------
KYC_PROVIDER=mock        # mock | hyperverge | idfy | digio
KYC_API_KEY=
KYC_API_SECRET=
KYC_WEBHOOK_SECRET=

# ---- Observability --------------------------------------------------------
POSTHOG_KEY=
SENTRY_DSN_API=
SENTRY_DSN_WORKER=

# ---- Web push (VAPID) -- Phase 11 -----------------------------------------

# ---- GST seller details -- Phase 10 (confirm SAC code with a CA) ----------
GST_SELLER_NAME=
GST_SELLER_GSTIN=
GST_SELLER_STATE_CODE=
GST_SELLER_ADDRESS=
GST_SAC_CODE=
GST_RATE_PERCENT=18

# ---- Gap-closure additions --------------------------------------------------
# Field-encryption key ring. Rotate with: pnpm --filter @marchmaker/api rotate-field-key
FIELD_ENCRYPTION_KEY_VERSION=1
FIELD_ENCRYPTION_KEYS_PREVIOUS=
FIELD_BLIND_INDEX_KEY=
FIELD_ENCRYPTION_KEY_KMS_WRAPPED=
AWS_REGION=ap-south-1
# Error reporting (required in production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Email provider: smtp | resend (webhook at /api/v1/webhooks/resend uses RESEND_WEBHOOK_SECRET)
# WhatsApp webhook (Meta) and on-call paging
ONCALL_WHATSAPP=
OTP_CHANNEL=sms
# Photo checks: none | mock | rekognition
IMAGE_MODERATION=none
# In-app voice calls (WebRTC): STUN is free; TURN needs a coturn server with a shared secret
RTC_STUN_URLS=stun:stun.l.google.com:19302
RTC_TURN_URLS=
RTC_TURN_SECRET=
RTC_TURN_TTL_SEC=3600
# KYC vendor presets (see docs/KYC.md): hyperverge | idfy | digio
KYC_MAPPING_JSON=
# Atlas (mongodb+srv) URL example. If the SRV lookup is refused on your network, set DNS_SERVERS.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/matchmakerdb?retryWrites=true&w=majority&appName=Cluster0
DNS_SERVERS=

# development: keep uploads on disk (memory | local | s3)
# STORAGE_PROVIDER=local
# LOCAL_STORAGE_DIR=./.data/storage
